# Copy this file to .env and fill in real values for LOCAL testing.
# Never commit the real .env — it is gitignored.
# In GitHub Actions, set these as repository Secrets instead (see README).

FINNHUB_API_KEY=your_finnhub_key_here
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: send the digest to a different address than the sender.
# DIGEST_TO=someone@example.com
